<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>PortalTarefas-Web-Laboratorio</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15"/>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15"/>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15"/>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0"/>
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0"/>
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0"/>
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.21.0"/>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.1"/>
  </ItemGroup>
</Project>
